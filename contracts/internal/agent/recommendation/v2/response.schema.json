{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodmind.internal/contracts/agent/recommendation/v2/response.schema.json",
  "title": "Recommendation Agent v2 success response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "requestId", "sessionId", "traceId", "agentTraceId", "status",
    "modelVersion", "modelPackageVersion", "featureSchemaVersion", "inferenceContractVersion",
    "modelKeyVersion", "diversityPolicyVersion", "reasonPolicyVersion", "templateVersion",
    "recommendations"
  ],
  "properties": {
    "contractVersion": { "const": "recommendation-agent-v2" },
    "requestId": { "$ref": "#/$defs/safeId" },
    "sessionId": { "$ref": "#/$defs/safeId" },
    "traceId": { "$ref": "#/$defs/safeId" },
    "agentTraceId": { "$ref": "#/$defs/safeId" },
    "status": { "const": "success" },
    "modelVersion": { "const": "hybrid-ranking-v1" },
    "modelPackageVersion": { "const": "recommendation-package-v1" },
    "featureSchemaVersion": { "const": "recommendation-features-v2" },
    "inferenceContractVersion": { "const": "recommendation-inference-v1" },
    "modelKeyVersion": { "const": "hmac-sha256-v1" },
    "diversityPolicyVersion": { "const": "recommendation-diversity-v1" },
    "reasonPolicyVersion": { "const": "recommendation-reasons-v1" },
    "templateVersion": { "const": "recommendation-template-v1" },
    "recommendations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/recommendation" },
      "allOf": [
        {
          "if": { "minItems": 1 },
          "then": { "contains": { "type": "object", "required": ["rank"], "properties": { "rank": { "const": 1 } } }, "minContains": 1, "maxContains": 1 }
        },
        {
          "if": { "minItems": 2 },
          "then": { "contains": { "type": "object", "required": ["rank"], "properties": { "rank": { "const": 2 } } }, "minContains": 1, "maxContains": 1 }
        },
        {
          "if": { "minItems": 3 },
          "then": { "contains": { "type": "object", "required": ["rank"], "properties": { "rank": { "const": 3 } } }, "minContains": 1, "maxContains": 1 }
        }
      ]
    }
  },
  "$defs": {
    "safeId": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "rank", "recommendationType", "probability", "modelScore", "reasons", "explanation"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/safeId" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "recommendationType": { "enum": ["PERSONAL", "EXPLORATORY", "GROUP_INSPIRED"] },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "modelScore": { "type": "number", "minimum": -100, "maximum": 100 },
        "reasons": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["USER_CF", "ITEM_CF", "PREFERENCE_MATCH", "WANT_TO_TRY", "GROUP_POPULAR", "CONTEXT_MATCH", "CLEANLINESS_OBSERVED"] }
        },
        "explanation": {
          "type": "string", "minLength": 1, "maxLength": 160,
          "pattern": "^[A-Za-z0-9 ,.'()-]+$",
          "not": { "pattern": "[Gg]uaranteed|[Bb]est|[Hh]ealthy|[Hh]ealthiest|[Ss]afe|[Ss]afest|[Aa]llergen-free|[Aa]llergy-safe|[Mm]edical|[Pp]erfect" }
        }
      }
    }
  }
}
