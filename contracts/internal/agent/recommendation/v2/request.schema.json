{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodmind.internal/contracts/agent/recommendation/v2/request.schema.json",
  "title": "Recommendation Agent v2 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "featureSchemaVersion",
    "requestId",
    "sessionId",
    "traceId",
    "deadlineAt",
    "decisionAt",
    "modelUserKey",
    "modelKeyVersion",
    "candidates"
  ],
  "properties": {
    "contractVersion": { "const": "recommendation-agent-v2" },
    "featureSchemaVersion": { "const": "recommendation-features-v2" },
    "requestId": { "$ref": "#/$defs/safeId" },
    "sessionId": { "$ref": "#/$defs/safeId" },
    "traceId": { "$ref": "#/$defs/safeId" },
    "deadlineAt": { "type": "string", "format": "date-time", "maxLength": 35 },
    "decisionAt": { "type": "string", "format": "date-time", "maxLength": 35 },
    "modelUserKey": {
      "type": "string",
      "minLength": 43,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "modelKeyVersion": { "const": "hmac-sha256-v1" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "modelKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "modelMealKey", "modelOfferingKey", "evidence"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/safeId" },
        "modelMealKey": { "$ref": "#/$defs/modelKey" },
        "modelOfferingKey": { "$ref": "#/$defs/modelKey" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferenceMatch",
        "wantToTry",
        "groupPreferenceRate",
        "groupEligibleMemberCount",
        "contextMatch",
        "cleanlinessObserved",
        "novelty",
        "cuisineCode",
        "categoryCode"
      ],
      "properties": {
        "preferenceMatch": { "type": "number", "minimum": 0, "maximum": 1 },
        "wantToTry": { "type": "boolean" },
        "groupPreferenceRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "groupEligibleMemberCount": { "type": "integer", "minimum": 0, "maximum": 100 },
        "contextMatch": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "cleanlinessObserved": { "type": "boolean" },
        "novelty": { "type": "number", "minimum": 0, "maximum": 1 },
        "cuisineCode": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Z0-9_]+$" },
        "categoryCode": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Z0-9_]+$" }
      }
    }
  }
}
