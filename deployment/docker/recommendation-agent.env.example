RECOMMENDATION_AGENT_APP_ENV=<staging-or-production>
RECOMMENDATION_AGENT_LOG_LEVEL=<INFO-or-WARNING>
RECOMMENDATION_AGENT_INTERNAL_SERVICE_TOKEN=<inject-via-secret-store>
RECOMMENDATION_AGENT_INFERENCE_BASE_URL=<private-https-origin>
RECOMMENDATION_AGENT_INFERENCE_ENDPOINT_PATH=</internal/v1/recommendations/score>
RECOMMENDATION_AGENT_INFERENCE_SERVICE_TOKEN=<inject-via-secret-store>
RECOMMENDATION_AGENT_MAX_ACTIVE_REQUESTS=<bounded-integer>
RECOMMENDATION_AGENT_MAX_QUEUED_REQUESTS=<bounded-integer>
RECOMMENDATION_AGENT_QUEUE_TIMEOUT_SECONDS=<bounded-seconds>
