RECOMMENDATION_AGENT_APP_ENV=local
RECOMMENDATION_AGENT_LOG_LEVEL=INFO
RECOMMENDATION_AGENT_INTERNAL_SERVICE_TOKEN=local-recommendation-token
RECOMMENDATION_AGENT_LLM_ENABLED=true
RECOMMENDATION_AGENT_LLM_BASE_URL=https://api.deepseek.com
RECOMMENDATION_AGENT_LLM_MODEL=deepseek-chat
RECOMMENDATION_AGENT_LLM_API_KEY=
RECOMMENDATION_AGENT_LLM_TIMEOUT_SECONDS=55
RECOMMENDATION_AGENT_LLM_MAX_RETRIES=2
RECOMMENDATION_AGENT_LLM_TEMPERATURE=0.1
RECOMMENDATION_AGENT_LLM_MAX_OUTPUT_TOKENS=4096

# Used only when LLM ranking is disabled or no LLM key is configured.
RECOMMENDATION_AGENT_INFERENCE_BASE_URL=http://127.0.0.1:8002
RECOMMENDATION_AGENT_INFERENCE_ENDPOINT_PATH=/internal/v1/recommendations/score
RECOMMENDATION_AGENT_INFERENCE_SERVICE_TOKEN=local-inference-only

