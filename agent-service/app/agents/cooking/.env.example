# FoodMind Cooking Plan Agent
#
# 使用方式：复制为 .env 后替换 <...> 占位符。不要提交 .env，里面会有密钥。
# 所有变量均以 COOKING_PLAN_ 为前缀；未知变量会导致服务启动失败。

# -----------------------------------------------------------------------------
# 必填：服务身份与运行环境
# -----------------------------------------------------------------------------
COOKING_PLAN_ENVIRONMENT=local
# production / staging 环境必须使用长度至少 16 位、随机生成的值。
COOKING_PLAN_INTERNAL_SERVICE_TOKEN=local-cooking-token
COOKING_PLAN_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM：DeepSeek（启用菜谱结构化抽取；可替换为任意 OpenAI 兼容端点）
# -----------------------------------------------------------------------------
COOKING_PLAN_LLM_ENABLED=true
COOKING_PLAN_LLM_BASE_URL=https://api.deepseek.com
COOKING_PLAN_LLM_MODEL=deepseek-chat
COOKING_PLAN_LLM_API_KEY=<replace-with-your-deepseek-api-key>
COOKING_PLAN_LLM_TIMEOUT_SECONDS=60
COOKING_PLAN_LLM_MAX_RETRIES=2
COOKING_PLAN_LLM_TEMPERATURE=0.1
COOKING_PLAN_LLM_MAX_OUTPUT_TOKENS=2048
COOKING_PLAN_LLM_MAX_CONCURRENCY=4
COOKING_PLAN_LLM_CONNECTION_POOL_SIZE=10
COOKING_PLAN_LLM_OVERALL_TIMEOUT_SECONDS=240

# 是否生成排程说明文字。打开后会额外调用 LLM；关闭时使用确定性说明。
COOKING_PLAN_EXPLANATION_ENABLED=false

# -----------------------------------------------------------------------------
# 核心排程与安全策略（可选；以下为推荐本地默认值）
# -----------------------------------------------------------------------------
COOKING_PLAN_MAX_RECIPE_COUNT=6
COOKING_PLAN_MAX_TASK_COUNT=100
COOKING_PLAN_SOLVER_TIMEOUT_SECONDS=5
COOKING_PLAN_SOLVER_OPTIMIZATION_LEVEL=full
COOKING_PLAN_SAFETY_POLICY_REGION=SG
# 若在新加坡部署可设为 SG。
# COOKING_PLAN_SAFETY_POLICY_VERSION=1.0

# -----------------------------------------------------------------------------
# HTTP 服务保护（可选）
# -----------------------------------------------------------------------------
COOKING_PLAN_MAX_ACTIVE_REQUESTS=20
COOKING_PLAN_MAX_QUEUED_REQUESTS=100
COOKING_PLAN_QUEUE_TIMEOUT_SECONDS=5
# 仅在浏览器跨域调用 API 时设置为明确的前端地址，使用英文逗号分隔；不要使用 *。
# COOKING_PLAN_CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com

# -----------------------------------------------------------------------------
# 可选：研究、缓存、断点与异步任务
# 默认关闭；不需要时保持当前值即可。
# -----------------------------------------------------------------------------
COOKING_PLAN_WEB_RESEARCH_ENABLED=false

COOKING_PLAN_CACHE_ENABLED=false
COOKING_PLAN_CACHE_TTL_SECONDS=3600
COOKING_PLAN_CACHE_MAX_ENTRIES=1000

COOKING_PLAN_CHECKPOINT_ENABLED=false
COOKING_PLAN_CHECKPOINT_BACKEND=sqlite
COOKING_PLAN_CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite

# Android/Web 的实时执行流（完成一步即返回下一批可做任务）需要开启。
COOKING_PLAN_TASK_API_ENABLED=true
COOKING_PLAN_TASK_DB_PATH=data/tasks.sqlite
COOKING_PLAN_TASK_WORKER_CONCURRENCY=2
COOKING_PLAN_TASK_SSE_ENABLED=true
COOKING_PLAN_TASK_QUEUE_BACKEND=inprocess
