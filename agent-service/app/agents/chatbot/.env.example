CHAT_AGENT_ENVIRONMENT=local
CHAT_AGENT_LOG_LEVEL=INFO
CHAT_AGENT_INTERNAL_SERVICE_TOKEN=local-chat-token
CHAT_AGENT_LLM_ENABLED=true
CHAT_AGENT_LLM_BASE_URL=https://api.deepseek.com
CHAT_AGENT_LLM_MODEL=deepseek-chat
CHAT_AGENT_LLM_API_KEY=
CHAT_AGENT_LLM_TIMEOUT_SECONDS=60
CHAT_AGENT_LLM_MAX_RETRIES=2
CHAT_AGENT_LLM_TEMPERATURE=0.3
CHAT_AGENT_LLM_MAX_OUTPUT_TOKENS=2048
CHAT_AGENT_MAX_ACTIVE_REQUESTS=20
CHAT_AGENT_MAX_QUEUED_REQUESTS=100
CHAT_AGENT_QUEUE_TIMEOUT_SECONDS=2
